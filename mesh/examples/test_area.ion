enum Shape:
    circle(Float)
    rect(Float, Float)
    line

impl ToString for Shape:
    fn to_string() -> String:
        return match self:
            :circle(r) => "Circle(radius=${r})"
            :rect(w, h) => "Rect(width=${w}, height=${h})"
            :line => "Line"

fn area(s: Shape) -> Result[Float, String]:
    return match s:
        :circle(r) =>
            println("Calculating area of circle with radius", r)
            :ok(r * r)
        :rect(w, h) => :ok(w * h)
        _ => :err("Unsupported shape")

const proc = fn():
    println("inside proc! yay!")
    const dat = receive()
    println("proc recievd", dat)

const v = proc
println(v)
const p = spawn v()
const r = :rect(3.0, 4.0)
println(r.to_string())
const a = area(r)
println(a)
println(Option)
send(p, "hello")
